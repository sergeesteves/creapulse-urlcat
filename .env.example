# Prefixe sous lequel l'app est servie. Doit correspondre au chemin du FQDN Coolify.
ROOT_PATH=/outils/urlcat

# Secret du jeton WordPress. MEME valeur que CREAPULSE_TOOLS_TOKEN_SECRET cote WP.
# 64 caracteres. Jamais commite. Voir lecon wp-jeton-signe-iframe-embed.
WP_TOKEN_SECRET=

# Secret de signature du cookie de session de l'app (independant du precedent).
SESSION_SECRET=

# Declaration d'usage -> Nimble. Vide = desactive.
WP_TOOL_EVENT_URL=https://www.creapulse.fr/wp-json/creapulse-tools/v1/tool-event
TOOL_SLUG=urlcat

# Plafonds. Mesure : ~1,1 ko de RAM par URL unique (voir README).
MAX_URLS_ANON=50000
MAX_URLS_MEMBRE=150000
MAX_RULES_BYTES=1048576
MAX_URLS_BYTES=8388608

# Classements simultanes autorises. Le pic RAM total = MAX_CONCURRENT x plafond x 1,1 ko.
MAX_CONCURRENT=2
